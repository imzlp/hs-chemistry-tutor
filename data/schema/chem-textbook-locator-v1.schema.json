{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/chem-textbook-locator-v1.schema.json",
  "title": "Unverified high-school chemistry textbook locator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "locator_id",
    "occurrence_id",
    "concept_id",
    "source_ref_index",
    "book_id",
    "book_title",
    "chapter",
    "section",
    "pages",
    "source_kind",
    "publisher",
    "edition",
    "isbn",
    "quote",
    "quote_locator",
    "page_ranges_inherited_from_ai_summary",
    "verification_status",
    "review_status",
    "human_verified",
    "verified_at",
    "verified_by",
    "evidence_status",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "chem-textbook-locator-v1"},
    "locator_id": {"type": "string", "pattern": "^tloc_[0-9a-f]{12}$"},
    "occurrence_id": {"type": "string", "pattern": "^kp_[0-9a-f]{12}$"},
    "concept_id": {"type": "string", "pattern": "^chem_[0-9a-f]{12}$"},
    "source_ref_index": {"type": "integer", "minimum": 1},
    "book_id": {"type": "string", "minLength": 1},
    "book_title": {"type": "string", "minLength": 1},
    "chapter": {"type": "string", "minLength": 1},
    "section": {"type": "string", "minLength": 1},
    "pages": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 1
    },
    "source_kind": {"const": "ai_textbook_analysis"},
    "publisher": {"type": "null"},
    "edition": {"type": "null"},
    "isbn": {"type": "null"},
    "quote": {"type": "null"},
    "quote_locator": {"type": "null"},
    "page_ranges_inherited_from_ai_summary": {"const": true},
    "verification_status": {
      "const": "unverified_ai_summary_pages_only"
    },
    "review_status": {"const": "unverified"},
    "human_verified": {"const": false},
    "verified_at": {"type": "null"},
    "verified_by": {"type": "null"},
    "evidence_status": {"const": "ai_textbook_summary_unverified"},
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
