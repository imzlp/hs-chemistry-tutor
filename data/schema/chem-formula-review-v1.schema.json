{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/chem-formula-review-v1.schema.json",
  "title": "Concept-scoped high-school chemistry formula review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "formula_review_id",
    "concept_id",
    "concept_name",
    "formula",
    "display_formula",
    "formula_kind",
    "role",
    "note",
    "review_method",
    "checks",
    "source_occurrence_ids",
    "source_refs",
    "source_verification",
    "review_status",
    "human_verified",
    "evidence_status",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "chem-formula-review-v1"},
    "formula_review_id": {"type": "string", "pattern": "^fmr_[0-9a-f]{12}$"},
    "concept_id": {"type": "string", "pattern": "^chem_[0-9a-f]{12}$"},
    "concept_name": {"type": "string", "minLength": 1},
    "formula": {"type": "string", "minLength": 1},
    "display_formula": {"type": "string", "minLength": 1},
    "formula_kind": {
      "enum": [
        "molecular_formula",
        "condensed_formula",
        "polymer_formula",
        "generic_formula",
        "ion_formula",
        "element_symbol",
        "indicator_generic",
        "protected_placeholder"
      ]
    },
    "role": {
      "enum": [
        "representative_substance",
        "class_general_formula",
        "contrast_example",
        "indicator_equilibrium",
        "protected_placeholder",
        "mentioned_species"
      ]
    },
    "note": {"type": "string", "minLength": 1},
    "review_method": {
      "enum": [
        "curated_formula_context",
        "machine_syntax_and_role_classification"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntax", "concept_scope", "textbook_context"],
      "properties": {
        "syntax": {"const": "passed"},
        "concept_scope": {
          "const": "typed_representation_not_identity_claim"
        },
        "textbook_context": {"const": "unverified_ai_summary"}
      }
    },
    "source_occurrence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^kp_[0-9a-f]{12}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "book_id",
          "book_title",
          "chapter",
          "section",
          "pages",
          "source_kind",
          "verification_status"
        ],
        "properties": {
          "book_id": {"type": "string", "minLength": 1},
          "book_title": {"type": "string", "minLength": 1},
          "chapter": {"type": "string", "minLength": 1},
          "section": {"type": "string", "minLength": 1},
          "pages": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "minItems": 1
          },
          "source_kind": {"type": "string", "minLength": 1},
          "verification_status": {
            "const": "unverified_ai_summary_pages_only"
          }
        }
      }
    },
    "source_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "publisher",
        "edition",
        "isbn",
        "quote",
        "quote_locator",
        "page_ranges_inherited_from_source"
      ],
      "properties": {
        "status": {"const": "unverified_ai_summary_pages_only"},
        "publisher": {"type": "null"},
        "edition": {"type": "null"},
        "isbn": {"type": "null"},
        "quote": {"type": "null"},
        "quote_locator": {"type": "null"},
        "page_ranges_inherited_from_source": {"const": true}
      }
    },
    "review_status": {"const": "machine_reviewed"},
    "human_verified": {"const": false},
    "evidence_status": {"const": "ai_textbook_summary_unverified"},
    "reviewed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
