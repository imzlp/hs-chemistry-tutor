{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/chem-equation-review-v1.schema.json",
  "title": "Reviewed high-school chemistry equation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "review_set_id",
    "review_set_key",
    "review_set_title",
    "domain",
    "concept_ids",
    "concept_names",
    "medium",
    "conditions",
    "set_notes",
    "ambiguity_notes",
    "equation_index",
    "role",
    "display",
    "note",
    "review_method",
    "machine_expression",
    "checks",
    "source_occurrence_ids",
    "source_refs",
    "source_verification",
    "review_status",
    "human_verified",
    "evidence_status",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "chem-equation-review-v1"},
    "review_id": {"type": "string", "pattern": "^eqr_[0-9a-f]{12}$"},
    "review_set_id": {"type": "string", "pattern": "^eqset_[0-9a-f]{12}$"},
    "review_set_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "review_set_title": {"type": "string", "minLength": 1},
    "domain": {
      "enum": [
        "electrochemistry",
        "organic_chemistry",
        "inorganic_chemistry",
        "equilibrium_chemistry"
      ]
    },
    "concept_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^chem_[0-9a-f]{12}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "concept_names": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "medium": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "set_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "ambiguity_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "equation_index": {"type": "integer", "minimum": 1},
    "role": {"type": "string", "minLength": 1},
    "display": {"type": "string", "minLength": 1},
    "note": {"type": "string", "minLength": 1},
    "review_method": {
      "enum": ["machine_mass_charge_check", "structural_review"]
    },
    "machine_expression": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "mass_balance",
        "charge_balance",
        "conditions",
        "state_symbols"
      ],
      "properties": {
        "method": {
          "enum": ["machine_mass_charge_check", "structural_review"]
        },
        "mass_balance": {
          "enum": ["passed", "not_applicable"]
        },
        "charge_balance": {
          "enum": ["passed", "not_applicable"]
        },
        "conditions": {
          "const": "metadata_only"
        },
        "state_symbols": {
          "const": "not_validated"
        }
      }
    },
    "source_occurrence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^kp_[0-9a-f]{12}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "book_id",
          "book_title",
          "chapter",
          "section",
          "pages",
          "source_kind",
          "verification_status"
        ],
        "properties": {
          "book_id": {"type": "string", "minLength": 1},
          "book_title": {"type": "string", "minLength": 1},
          "chapter": {"type": "string", "minLength": 1},
          "section": {"type": "string", "minLength": 1},
          "pages": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "minItems": 1
          },
          "source_kind": {"type": "string", "minLength": 1},
          "verification_status": {
            "const": "unverified_ai_summary_pages_only"
          }
        }
      }
    },
    "source_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "publisher",
        "edition",
        "isbn",
        "quote",
        "quote_locator",
        "page_ranges_inherited_from_source"
      ],
      "properties": {
        "status": {"const": "unverified_ai_summary_pages_only"},
        "publisher": {"type": "null"},
        "edition": {"type": "null"},
        "isbn": {"type": "null"},
        "quote": {"type": "null"},
        "quote_locator": {"type": "null"},
        "page_ranges_inherited_from_source": {"const": true}
      }
    },
    "review_status": {"const": "machine_reviewed"},
    "human_verified": {"const": false},
    "evidence_status": {"const": "ai_textbook_summary_unverified"},
    "reviewed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_method": {"const": "machine_mass_charge_check"}
        },
        "required": ["review_method"]
      },
      "then": {
        "properties": {
          "machine_expression": {"type": "string", "minLength": 1},
          "checks": {
            "properties": {
              "method": {"const": "machine_mass_charge_check"},
              "mass_balance": {"const": "passed"},
              "charge_balance": {"const": "passed"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_method": {"const": "structural_review"}
        },
        "required": ["review_method"]
      },
      "then": {
        "properties": {
          "machine_expression": {"type": "null"},
          "checks": {
            "properties": {
              "method": {"const": "structural_review"},
              "mass_balance": {"const": "not_applicable"},
              "charge_balance": {"const": "not_applicable"}
            }
          }
        }
      }
    }
  ]
}
