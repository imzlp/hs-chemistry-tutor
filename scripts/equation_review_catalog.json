        },
        {
          "role": "overall_reaction",
          "display": "Zn(s) + Cu²⁺(aq) → Zn²⁺(aq) + Cu(s)",
          "balance": "Zn(s) + Cu^2+(aq) -> Zn^2+(aq) + Cu(s)",
          "note": "总反应为自发的置换型氧化还原反应。"
        }
      ]
