      "domain": "electrochemistry",
      "concept_ids": ["chem_2bf21e94d03b"],
      "title": "锌铜稀硫酸原电池",
      "medium": "aqueous_acidic",
      "conditions": ["锌作负极，铜作正极", "稀硫酸为电解质", "闭合回路"],
      "notes": [
        "该装置的正极反应物是溶液中的 H⁺，不是 Cu²⁺。",
        "不能把该体系与含 Cu²⁺/CuSO₄ 的丹尼尔电池混写。"
      ],
      "ambiguity_notes": [],
      "equations": [
        {
          "role": "anode_half_reaction",
          "display": "Zn(s) → Zn²⁺(aq) + 2e⁻",
          "balance": "Zn(s) -> Zn^2+(aq) + 2e^-",
          "note": "锌发生氧化反应。"
        },
        {
          "role": "cathode_half_reaction",
          "display": "2H⁺(aq) + 2e⁻ → H₂(g)",
          "balance": "2H^+(aq) + 2e^- -> H2(g)",
          "note": "铜片提供导电表面，H⁺在正极得电子。"
        },
        {
          "role": "overall_reaction",
          "display": "Zn(s) + 2H⁺(aq) → Zn²⁺(aq) + H₂(g)",
          "balance": "Zn(s) + 2H^+(aq) -> Zn^2+(aq) + H2(g)",
          "note": "总离子方程式与电池总反应一致。"
        }
      ]
    },
